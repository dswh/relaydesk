# Copy to .env.local only in a fresh clone. Add your own keys privately.
DATABASE_URL=postgresql://relaydesk:relaydesk_local@127.0.0.1:5440/relaydesk_rag_evals
DATABASE_POOL_MAX=5
DATABASE_SSL=disable

RELAYDESK_HELP_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
RELAYDESK_OPENROUTER_PROVIDERS=openai
RELAYDESK_HELP_GENERATION_MODEL=openai/gpt-4.1-mini
RELAYDESK_HELP_JUDGE_MODEL=openai/gpt-4.1
RELAYDESK_HELP_EMBEDDING_MODE=gateway
RELAYDESK_HELP_EMBEDDING_MODEL=openai/text-embedding-3-small

# Set an absolute path inside this clone before indexing or running the loop.
# Keep the same ledger for every run. Do not delete it to renew the allowance.
RELAYDESK_MODEL_BUDGET_USD=0.50
RELAYDESK_MODEL_BUDGET_FILE=

# Create this tracing project in your own LangSmith workspace.
# Use your workspace's API endpoint. The default below is the US endpoint.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=relaydesk-loop-workshop
LANGSMITH_AGENT_ID=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TRACING=true

RAG_REVIEW_PORT=4181
