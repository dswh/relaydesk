# Dedicated local RAG workshop database. Synthetic data only.
DATABASE_URL=postgresql://relaydesk:relaydesk_local@127.0.0.1:5440/relaydesk_rag_evals
DATABASE_POOL_MAX=5
DATABASE_SSL=disable

# Configure current provider models before live capture.
AI_GATEWAY_API_KEY=
RELAYDESK_HELP_GENERATION_MODEL=
RELAYDESK_HELP_JUDGE_MODEL=
RELAYDESK_HELP_EMBEDDING_MODE=fixture
RELAYDESK_HELP_EMBEDDING_MODEL=openai/text-embedding-3-small

# Use a scoped service key for datasets, feedback, and experiments.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=relaydesk-rag-workshop
LANGSMITH_AGENT_ENVIRONMENT=local
LANGSMITH_PROJECT=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ORGANIZATION_ID=
LANGSMITH_TRACING_PROJECT_ID=
LANGSMITH_TRACING=false

RAG_REVIEW_PORT=4180
RAG_RECHECK_MINUTES=30
