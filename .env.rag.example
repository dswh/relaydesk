# Local RAG project. Synthetic data only.
DATABASE_URL=postgresql://relaydesk:relaydesk_local@127.0.0.1:5440/relaydesk_rag_evals
DATABASE_POOL_MAX=5
DATABASE_SSL=disable

RELAYDESK_HELP_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
RELAYDESK_OPENROUTER_PROVIDERS=openai
RELAYDESK_HELP_GENERATION_MODEL=openai/gpt-4.1-mini
RELAYDESK_HELP_JUDGE_MODEL=openai/gpt-4.1
RELAYDESK_HELP_EMBEDDING_MODE=gateway
RELAYDESK_HELP_EMBEDDING_MODEL=openai/text-embedding-3-small

# Use a tracing project in your own workspace and its region's API endpoint.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=relaydesk-rag
LANGSMITH_AGENT_ID=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TRACING=true
RAG_REVIEW_PORT=4181
