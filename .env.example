DATABASE_URL=postgresql://relaydesk:relaydesk@localhost:5433/relaydesk
DATABASE_POOL_MAX=10
DATABASE_SSL=disable

# Optional. Enables live grounded replies and the blinded LLM judge.
AI_GATEWAY_API_KEY=
RELAYDESK_AI_MODEL=anthropic/claude-sonnet-5
RELAYDESK_AI_JUDGE_MODEL=anthropic/claude-sonnet-5

# Customer help chat. Fixture embeddings use pgvector without external calls.
RELAYDESK_HELP_GENERATION_MODEL=anthropic/claude-sonnet-5
RELAYDESK_HELP_JUDGE_MODEL=anthropic/claude-sonnet-5
RELAYDESK_HELP_EMBEDDING_MODE=fixture
RELAYDESK_HELP_EMBEDDING_MODEL=openai/text-embedding-3-small
RELAYDESK_HELP_TOP_K=2
RELAYDESK_HELP_VECTOR_WEIGHT=1
RELAYDESK_HELP_LEXICAL_WEIGHT=0
RELAYDESK_HELP_MINIMUM_EVIDENCE=0
RELAYDESK_HELP_CONTEXT_BUDGET=7000
RELAYDESK_HELP_INCLUDE_CONTEXT=false
RELAYDESK_HELP_REQUIRE_CITATIONS=false
RELAYDESK_HELP_STRICT_EVIDENCE=false
RELAYDESK_HELP_CLARIFY_AMBIGUOUS=false
RELAYDESK_HELP_SAFE_PROMPT_HANDLING=false
RELAYDESK_HELP_EVAL_REPEATS=3
